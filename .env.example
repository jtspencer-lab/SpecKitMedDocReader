# Environment Configuration
# Copy this file to .env and update values for your environment

# Backend API
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN_KEY=auth_token

# Features
VITE_ENABLE_BATCH_UPLOAD=true
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff

# Display
VITE_ITEMS_PER_PAGE=10
VITE_AUTO_REFRESH_INTERVAL=5000

# --- Backend Configuration ---

# Database
DATABASE_URL=postgresql://signupreader:password@localhost:5432/signupreader_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Azure Form Recognizer
AZURE_FORM_RECOGNIZER_ENDPOINT=https://<your-region>.api.cognitive.microsoft.com/
AZURE_FORM_RECOGNIZER_KEY=your-key-here

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# OCR Settings
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_LANGUAGE=en

# NLP Settings
SPACY_MODEL=en_core_web_md

# Logging
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Audit
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=365
